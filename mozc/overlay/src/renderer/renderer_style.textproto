# proto-file: protocol/renderer_style.proto
# proto-message: RendererStyle
#
# Yamatana AI IME modernized Windows candidate-window theme.
# Keep the upstream renderer and behavior intact while replacing Mozc's
# compact/legacy visual treatment with a calmer Windows 11-like surface.
window_border: 1
scrollbar_width: 3
row_rect_padding: 4
border_color { r: 218 g: 221 b: 227 }

shortcut_style {
  font_size: 13
  foreground_color { r: 103 g: 109 b: 120 }
  background_color { r: 247 g: 248 b: 250 }
  left_padding: 10
  right_padding: 10
}

gap1_style { font_size: 15 }

candidate_style {
  font_size: 15
  foreground_color { r: 30 g: 32 b: 36 }
}

description_style {
  font_size: 12
  foreground_color { r: 112 g: 117 b: 126 }
  right_padding: 12
}

# Keep enough width for Mozc's built-in special candidate labels.
column_minimum_width_string: "そのほかの文字種"

footer_style {
  font_size: 12
  foreground_color { r: 90 g: 95 b: 104 }
  left_padding: 8
  right_padding: 8
}

footer_sub_label_style {
  font_size: 10
  foreground_color { r: 145 g: 149 b: 157 }
  left_padding: 8
  right_padding: 8
}

# Flat footer instead of the old beveled/gradient treatment.
footer_border_colors { r: 229 g: 231 b: 235 }
footer_top_color { r: 250 g: 250 b: 251 }
footer_bottom_color { r: 250 g: 250 b: 251 }
logo_file_name: "candidate_window_logo.tiff"

# Soft focus treatment: visible enough for keyboard navigation without the
# saturated legacy-blue block.
focused_background_color { r: 238 g: 246 b: 255 }
focused_border_color { r: 151 g: 194 b: 255 }

scrollbar_background_color { r: 247 g: 248 b: 250 }
scrollbar_indicator_color { r: 177 g: 182 b: 191 }

infolist_style {
  caption_string: "用例"
  caption_height: 26
  caption_padding: 4
  caption_style {
    font_size: 12
    left_padding: 8
  }
  caption_background_color { r: 248 g: 249 b: 251 }
  window_border: 1
  row_rect_padding: 5
  window_width: 340
  title_style {
    font_size: 15
    left_padding: 10
  }
  description_style {
    font_size: 12
    left_padding: 18
  }
  border_color { r: 218 g: 221 b: 227 }
  focused_background_color { r: 238 g: 246 b: 255 }
  focused_border_color { r: 151 g: 194 b: 255 }
}
